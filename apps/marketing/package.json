{
  "name": "@nomadware/marketing",
  "private": true,
  "description": "The nomadware.io marketing site (Astro on Vercel: static pages + the contact endpoint)",
  "type": "module",
  "scripts": {
    "dev": "astro dev --ignore-lock",
    "build": "astro check && astro build",
    "preview": "node ../../tools/vercel-preview/src/main.ts --framework astro",
    "check": "astro check",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/vercel": "11.0.16",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "astro": "7.4.2",
    "posthog-js": "1.438.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "24.x"
  }
}
