---
import { Font } from 'astro:assets';

import ConsentBanner from '../components/consent-banner.astro';
import JsonLd from '../components/json-ld.astro';
import SeoHead from '../components/seo-head.astro';
import { FULL_MOTION_CLASS } from '../constants';
import '../styles/global.css';

// The dev server ignores prefers-reduced-motion, so every effect can be judged as designed
// (styles/contact-terminal.css reads the class; production never gets it).
const fullMotion = import.meta.env.DEV;
---

<!doctype html>
<html lang="en" class={fullMotion ? FULL_MOTION_CLASS : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Marks JS as available before first paint, so no-JS fallbacks never flash. A reload opens
         at the top, where the intro plays, not where the reader left off (a #link still lands). -->
    <script is:inline>
      document.documentElement.classList.add('js');
      history.scrollRestoration = 'manual';
    </script>
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />
    <SeoHead />
    <JsonLd />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="frame" data-grid-paper>
      <canvas class="grid-canvas" data-grid-canvas aria-hidden="true" hidden></canvas>
      <div class="wrap">
        <slot />
      </div>
    </div>
    <ConsentBanner />
    <script>
      import { initGridWarp } from '../scripts/grid-warp';
      import { whenIdle } from '../scripts/motion';
      whenIdle(initGridWarp);
    </script>
  </body>
</html>
