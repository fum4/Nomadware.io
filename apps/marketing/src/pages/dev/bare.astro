---
// TEMPORARY (NWARE-82): dev-only control page for the iOS scroll jitter: long plain text and
// nothing else (no sticky, no canvas, no overlays, no smooth scroll, no clip), same origin as the
// page under test. `?probe` adds the viewport readout. 404 outside dev.
export const prerender = false;

if (!import.meta.env.DEV) return new Response(null, { status: 404 });

const PARAGRAPHS = Array.from(
  { length: 60 },
  (_, index) =>
    `${index + 1}. Plain text, nothing else on the page. Scroll up and down slowly and watch whether these lines jitter while the browser's bottom bar collapses and expands.`,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>bare scroll test</title>
  </head>
  <body style="margin: 0; padding: 16px; background: #0b0b0f; color: #ddd; font: 16px/1.6 sans-serif">
    {PARAGRAPHS.map((text) => <p>{text}</p>)}
    <script>
      import { probeOn } from '../../scripts/bisect';
      if (probeOn(location.search)) {
        void import('../../scripts/viewport-probe').then(({ initViewportProbe }) =>
          initViewportProbe(),
        );
      }
    </script>
  </body>
</html>
