---
import ContactTerminal from '../components/contact-terminal.astro';
import Hero from '../components/hero.astro';
import HowWeWork from '../components/how-we-work.astro';
import SiteFooter from '../components/site-footer.astro';
import SiteNav from '../components/site-nav.astro';
import StatsStrip from '../components/stats-strip.astro';
import { STATS_PAGE_CACHE_CONTROL } from '../constants';
import { loadStats } from '../data/load-stats';
import BaseLayout from '../layouts/base-layout.astro';

// Rendered per request (behind Vercel's CDN cache) so the stats strip carries the live numbers.
export const prerender = false;

const stats = await loadStats();
const renderedAt = new Date().toISOString();
Astro.response.headers.set('Cache-Control', STATS_PAGE_CACHE_CONTROL);
---

<BaseLayout>
  <SiteNav />
  <main id="main" tabindex="-1">
    <Hero />
    <StatsStrip stats={stats} renderedAt={renderedAt} />
    <HowWeWork />
    <ContactTerminal />
  </main>
  <SiteFooter renderedAt={renderedAt} />
</BaseLayout>

<script>
  // Headline, stats and wordmark animate in one order (scripts/intro-sequence.ts).
  import { playIntro } from '../scripts/intro-sequence';
  void playIntro();
</script>
