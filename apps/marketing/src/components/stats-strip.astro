---
import { STAT_WINDOWS } from '@nomadware/site-stats';

import { STATS_STALE_AFTER_MS } from '../constants';
import type { LoadedStats } from '../data/load-stats';
import { DEFAULT_STAT_WINDOW } from '../data/stats-snapshot';
import RelativeTime from './relative-time.astro';
import StatValue from './stat-value.astro';

interface Props {
  stats: LoadedStats;
  renderedAt: string;
}
const { stats, renderedAt } = Astro.props;
const { snapshot, source } = stats;
// Over a day old (the publisher stopped, or this is the bundled fallback): no live dot.
const stale = Date.parse(renderedAt) - Date.parse(snapshot.generatedAt) > STATS_STALE_AFTER_MS;
const days = (range: string): string => `${Number.parseInt(range, 10)} days`;
---

<section
  class:list={['stats', { stale }]}
  aria-labelledby="stats-title"
  data-stats
  data-stats-source={source}
>
  <h2 id="stats-title" class="sr-only">What the studio shipped</h2>
  <div class="head">
    <span class="range">
      Last <span class="range-label">
        {
          /* Every range's label is laid out in one grid cell, only the current one visible: the
             cell is as wide as the longest, so switching never moves the toggle beside it. */
          STAT_WINDOWS.map((range) => (
            <span data-range-label={range} data-current={range === DEFAULT_STAT_WINDOW ? '' : undefined}>
              {days(range)}
            </span>
          ))
        }
      </span>
      <span class="seg" role="group" aria-label="Time range">
        {
          STAT_WINDOWS.map((range) => (
            <button
              type="button"
              data-range={range}
              aria-pressed={range === DEFAULT_STAT_WINDOW ? 'true' : 'false'}
            >
              {range}
            </button>
          ))
        }
      </span>
    </span>
    <span class="live">
      <span class="dot" aria-hidden="true"></span>updated <RelativeTime
        iso={snapshot.generatedAt}
        renderedAt={renderedAt}
      />
    </span>
  </div>
  <dl class="grid">
    <div class="cell">
      <dt class="lab">PRs merged</dt>
      <dd class="num"><StatValue stat="prs" snapshot={snapshot} /></dd>
    </div>
    <div class="cell">
      <dt class="lab">agent runs</dt>
      <dd class="num"><StatValue stat="runs" snapshot={snapshot} /></dd>
    </div>
    <div class="cell">
      <dt class="lab">agent-hours</dt>
      <dd class="num"><StatValue stat="agentHours" snapshot={snapshot} /><small>h</small></dd>
    </div>
    <div class="cell">
      <dt class="lab">
        checks run<span class="sep"> · </span><b><StatValue stat="caught" snapshot={snapshot} /> issues caught</b>
      </dt>
      <dd class="num"><StatValue stat="checks" snapshot={snapshot} /></dd>
    </div>
    <div class="cell">
      <dt class="lab">agent tool calls</dt>
      <dd class="num"><StatValue stat="actions" snapshot={snapshot} /></dd>
    </div>
    <div class="cell">
      <dt class="lab">lines changed</dt>
      <dd class="num">
        +<StatValue stat="linesAdded" snapshot={snapshot} /><span class="neg">−<StatValue stat="linesDeleted" snapshot={snapshot} /></span>
      </dd>
    </div>
  </dl>
</section>

<style>
  .stats {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    backdrop-filter: blur(6px);
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--line);
    font: 400 11px/var(--leading) var(--mono);
    color: var(--dim);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .live {
    display: flex;
    align-items: center;
    gap: 8px;
    letter-spacing: 0;
    text-transform: none;
    white-space: nowrap;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sig);
    animation: pulse 2s infinite;
  }

  /* Same box, so nothing moves: only the colour and the pulse go. */
  .stale .dot {
    background: var(--faint);
    animation: none;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(198, 255, 74, 0.6);
    }
    70%,
    100% {
      box-shadow: 0 0 0 6px rgba(198, 255, 74, 0);
    }
  }

  .range-label {
    display: inline-grid;
  }

  .range-label > span {
    grid-area: 1 / 1;
  }

  .range-label > span:not([data-current]) {
    visibility: hidden;
  }

  .seg {
    display: inline-flex;
    margin-left: 10px;
    overflow: hidden;
    vertical-align: middle;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .seg button {
    padding: 3px 8px;
    border: 0;
    background: none;
    color: var(--dim);
    font: 500 10px/var(--leading) var(--mono);
    cursor: pointer;
  }

  .seg button[aria-pressed='true'] {
    background: var(--chip);
    color: var(--fg);
  }

  .seg button:focus-visible {
    outline-offset: -2px;
  }

  :global(html:not(.js)) .seg {
    display: none;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
  }

  .cell {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding: 20px 18px 18px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .cell:nth-child(3n) {
    border-right: 0;
  }

  .cell:nth-last-child(-n + 3) {
    border-bottom: 0;
  }

  .num {
    margin: 0;
    font: 500 38px/var(--leading) var(--sans);
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* line-height 1: the smaller inline parts sit inside the number's line box, so its height never
     depends on font metrics (a fallback font would otherwise change it). */
  .num small,
  .neg {
    line-height: 1;
  }

  .num small {
    margin-left: 2px;
    font-size: 18px;
    color: var(--dim);
  }

  .neg {
    margin-left: 6px;
    font-size: 22px;
    color: var(--dim);
  }

  .lab {
    margin-top: 6px;
    font: 400 12px/var(--leading) var(--mono);
    color: var(--dim);
  }

  .lab b {
    color: var(--warm);
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .head {
      padding: 11px 14px;
    }

    .grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cell {
      padding: 16px 14px 14px;
    }

    .cell:nth-child(n) {
      border-right: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }

    .cell:nth-child(2n) {
      border-right: 0;
    }

    .cell:nth-last-child(-n + 2) {
      border-bottom: 0;
    }

    .num {
      font-size: 30px;
    }

    .neg {
      margin-left: 4px;
      font-size: 17px;
    }

    .lab {
      font-size: 11px;
    }

    /* "31 issues caught" gets its own line on phones. */
    .lab .sep {
      display: none;
    }

    .lab b {
      display: block;
    }
  }
</style>
