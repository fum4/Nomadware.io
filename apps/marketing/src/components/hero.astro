---
import { HERO_TAGS } from '../constants';

const HEADLINE = 'We build software.';
// Each slot shows its pool's first word and reserves its longest (scripts/tags-rotate.ts).
const SLOTS = HERO_TAGS.pools.map((pool) => ({
  word: pool[0],
  chars: Math.max(...pool.map((word) => word.length)),
}));
const STATIC_LINE = SLOTS.map((slot) => slot.word).join(' / ');
// Two pairs, so a narrow phone can set them as two rows (slots 1–2 / 3–4).
const PAIRS = [SLOTS.slice(0, 2), SLOTS.slice(2)];
---

<section class="hero" aria-labelledby="hero-title">
  <canvas class="dots" data-dot-field aria-hidden="true"></canvas>
  <div class="copy">
    <p class="eyebrow">Small studio · large output</p>
    <h1 id="hero-title">
      <span class="headline" data-scramble>{HEADLINE}</span>{' '}
      <!-- Two blocks: breaks after the comma at every width; the space keeps the text one sentence. -->
      <span class="subline"><span>Human judgment,</span>{' '}<span>at agent speed.</span></span>
    </h1>
    <!-- The visible line rotates; readers get the server-rendered words once, never each swap. -->
    <p class="tags">
      <span class="sr-only">{STATIC_LINE}</span><span aria-hidden="true" data-tags>{PAIRS.map((pair, pairIndex) => <>{pairIndex > 0 && <span class="slash between" data-slash>/</span>}<span class="pair">{pair.map((slot, index) => <>{index > 0 && <span class="slash" data-slash>/</span>}<span class="slot" data-tag style={`--slot-chars: ${slot.chars}`}>{slot.word}</span></>)}</span></>)}</span>
    </p>
  </div>
</section>

<script>
  import { initDotField } from '../scripts/dot-field';
  import { whenIdle } from '../scripts/motion';
  whenIdle(initDotField);
</script>

<style>
  .hero {
    position: relative;
    padding: 96px 0 60px;
  }

  .dots {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
  }

  /* The text halo: an ink veil hugging the copy (fit-content: the widest line, so the text sets
     exactly as without it), fading out over --halo-fade beyond it, so the dots drawn underneath
     recede behind the words. Two intersected linear masks make a soft-cornered rectangle with
     no edge anywhere; painted once, no blur, no layout. */
  .copy {
    --halo-fade: 140px;

    position: relative;
    width: fit-content;
  }

  .copy::before {
    content: '';
    position: absolute;
    inset: calc(var(--halo-fade) * -1);
    z-index: -1;
    pointer-events: none;
    background: var(--halo-text);
    --halo-ramp: transparent, rgba(0, 0, 0, 0.2) calc(var(--halo-fade) * 0.35),
      rgba(0, 0, 0, 0.6) calc(var(--halo-fade) * 0.65), #000 var(--halo-fade),
      #000 calc(100% - var(--halo-fade)), rgba(0, 0, 0, 0.6) calc(100% - var(--halo-fade) * 0.65),
      rgba(0, 0, 0, 0.2) calc(100% - var(--halo-fade) * 0.35), transparent;
    mask-image: linear-gradient(90deg, var(--halo-ramp)), linear-gradient(var(--halo-ramp));
    mask-composite: intersect;
  }

  .eyebrow,
  .tags {
    margin: 0;
    font: 400 11px/var(--leading) var(--mono);
    color: var(--dim);
    text-transform: uppercase;
  }

  .eyebrow {
    letter-spacing: 0.12em;
  }

  .tags {
    --tags-tracking: 0.14em;
    --slash-gap: 2ch;

    letter-spacing: var(--tags-tracking);
    white-space: nowrap;
  }

  /* Mono: every character advances 1ch plus the tracking, so this is the longest word's width.
     Centred, so a shorter word's leftover splits evenly around it instead of piling up before
     the next slash; a row's first slot starts flush, on the copy's left edge. */
  .slot {
    display: inline-block;
    width: calc(var(--slot-chars) * (1ch + var(--tags-tracking)));
    text-align: center;
  }

  .pair:first-child > .slot:first-child {
    text-align: start;
  }

  /* Wide enough that the up-to-2ch leftover inside a slot reads as small beside it. */
  .slash {
    margin: 0 var(--slash-gap);
    color: var(--sig);
  }

  /* Dark until scripts/tags-flicker.ts lights them, inside the intro's gap after the headline
     (only with JS); the failsafe lights them anyway if the intro never runs. */
  :global(html.js) [data-tags] :is([data-tag], [data-slash]) {
    opacity: 0;
    animation: tags-failsafe 0s 4s forwards;
  }

  @keyframes tags-failsafe {
    to {
      opacity: 1;
    }
  }

  h1 {
    max-width: 760px;
    margin: 16px 0 24px;
    font-weight: 500;
    font-size: 72px;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .headline,
  .subline {
    display: block;
  }

  .subline {
    color: var(--dim);
  }

  .subline > span {
    display: block;
  }

  /* Built by scripts/headline-scramble.ts: the real text stays laid out (painted only up to the
     reveal point by an inline background clipped to it), glyphs cover the rest from an overlay. */
  .headline:global(.is-scrambling) {
    position: relative;
    color: transparent;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
  }

  .headline :global(.scramble-glyphs) {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    color: var(--sig);
  }

  .headline :global(.scramble-glyphs > span) {
    position: absolute;
  }

  .headline :global(.scramble-glyphs > span)::after {
    content: attr(data-glyph);
  }

  @media (max-width: 640px) {
    .hero {
      padding: 64px 0 40px;
    }

    h1 {
      margin: 14px 0 18px;
      font-size: 42px;
    }

    .copy {
      --halo-fade: 72px;
    }

    /* 1.5ch on phones: the one-row line (337px) then fits a 390px screen. */
    .tags {
      --slash-gap: 1.5ch;
    }

  }

  /* The four slots don't fit one row on a narrow phone: two rows, slots 1–2 / 3–4. */
  @media (max-width: 380px) {
    .pair {
      display: block;
    }

    .between {
      display: none;
    }

    .pair > .slot:first-child {
      text-align: start;
    }
  }
</style>
