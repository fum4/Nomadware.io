---
const HEADLINE = 'We build software.';
const TAGS = ['web', 'mobile', 'backend', 'infra'];
---

<section class="hero" aria-labelledby="hero-title">
  <canvas class="dots" data-dot-field aria-hidden="true"></canvas>
  <p class="eyebrow">Small studio · large output</p>
  <h1 id="hero-title">
    <span class="headline" data-scramble>{HEADLINE}</span>
    <span class="subline">Human judgment, at agent speed.</span>
  </h1>
  <p class="tags">{TAGS.map((tag, index) => <>{index > 0 && <span class="slash">/</span>}{tag}</>)}</p>
</section>

<script>
  import { initDotField } from '../scripts/dot-field';
  import { initHeadlineScramble } from '../scripts/headline-scramble';
  import { whenIdle } from '../scripts/motion';
  initHeadlineScramble();
  whenIdle(initDotField);
</script>

<style>
  .hero {
    position: relative;
    padding: 96px 0 60px;
  }

  .dots {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
  }

  .eyebrow,
  .tags {
    margin: 0;
    font: 400 11px/var(--leading) var(--mono);
    color: var(--dim);
    text-transform: uppercase;
  }

  .eyebrow {
    letter-spacing: 0.12em;
  }

  .tags {
    letter-spacing: 0.14em;
  }

  .slash {
    margin: 0 8px;
    color: var(--sig);
  }

  h1 {
    max-width: 760px;
    margin: 16px 0 24px;
    font-weight: 500;
    font-size: 72px;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .headline,
  .subline {
    display: block;
  }

  .subline {
    color: var(--dim);
  }

  /* Built by scripts/headline-scramble.ts: the real letter keeps its space, a glyph covers it. */
  .headline :global(.scrambled) {
    position: relative;
    color: transparent;
  }

  .headline :global(.scrambled)::after {
    content: attr(data-glyph);
    position: absolute;
    top: 0;
    left: 0;
    color: var(--sig);
  }

  @media (max-width: 640px) {
    .hero {
      padding: 64px 0 40px;
    }

    h1 {
      margin: 14px 0 18px;
      font-size: 42px;
    }

    .slash {
      margin: 0 5px;
    }
  }
</style>
