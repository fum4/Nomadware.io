---
// A small line icon for the chart tooltip's rows (stats-chart.astro): hand-drawn on a 12 px grid,
// stroked in currentColor (the row's own colour), decorative (the chart is aria-hidden anyway).
interface Props {
  name: 'robot' | 'merge';
}
const { name } = Astro.props;
---

<svg class={`icon icon-${name}`} viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
  {
    name === 'robot' && (
      <>
        <rect x="2" y="4" width="8" height="6.5" rx="1.75" />
        <path d="M6 4V1.75M0.75 6.5v2M11.25 6.5v2M4.5 6.75v.75M7.5 6.75v.75" />
      </>
    )
  }
  {
    name === 'merge' && (
      <>
        <circle cx="3.25" cy="2.5" r="1.25" />
        <circle cx="3.25" cy="9.5" r="1.25" />
        <circle cx="9" cy="6" r="1.25" />
        <path d="M3.25 3.75v4.5M3.25 3.75c0 1.6 1.4 2.25 4.5 2.25" />
      </>
    )
  }
</svg>

<style>
  .icon {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
