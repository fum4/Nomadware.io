---
import '../styles/contact-terminal.css';
import { CONTACT_SITE_KEY } from '../config/contact';
import { SITE } from '../config/site';
import { CONTACT } from '../constants';
import ContactField from './contact-field.astro';
import PageSection from './page-section.astro';

// "send" posts to /api/contact (src/pages/api/contact.ts). No form action: without JS the form
// can't pass Turnstile, so it points at the address instead (.term-nojs).
---

<PageSection id="contact" title="Contact">
  <form
    class="term is-idle"
    data-contact
    data-sitekey={CONTACT_SITE_KEY}
    aria-labelledby="contact-heading"
  >
    <div class="term-bar">
      <span class="term-title">
        {/* Decorative macOS window buttons. */}
        <span class="term-lights" aria-hidden="true"><span /><span /><span /></span>
        <span class="term-path">~/nomadware</span>
      </span>
      <a class="term-mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
    <div class="term-body">
      <h3 class="term-heading" id="contact-heading">Tell us what you're building.</h3>
      <ContactField
        name="name"
        placeholder="your name"
        autocomplete="name"
        maxlength={CONTACT.maxNameLength}
      />
      <ContactField
        name="email"
        inputmode="email"
        placeholder="you@company.com"
        autocomplete="email"
        maxlength={CONTACT.maxEmailLength}
        error="that address doesn't look right"
      />
      <ContactField
        name="brief"
        multiline
        placeholder="what you're building, where it hurts"
        maxlength={CONTACT.maxBriefLength}
      />
      {/* Honeypot: off-screen and out of the tab order, so only bots fill it in. */}
      <div class="term-trap" aria-hidden="true">
        <label for="contact-website">website</label>
        <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
    </div>
    {/* Turnstile mounts here; it only takes space when Cloudflare asks for an interaction.
        ph-no-capture: blocked out of session replay and autocapture. */}
    <div class="term-challenge ph-no-capture" data-challenge></div>
    {/* data-private: the success line repeats the visitor's email address. */}
    <p class="term-out" role="status" data-output data-private></p>
    <p class="term-nojs">
      JavaScript is off: write to <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
    </p>
    <div class="term-run">
      <span class="term-hints" aria-hidden="true"
        ><kbd>↑↓</kbd> move · <kbd>⌘ ⏎</kbd> send</span
      >
      <button class="term-send" type="submit">send</button>
    </div>
  </form>
</PageSection>

<script>
  import { initContactForm } from '../scripts/contact/contact-form';
  initContactForm();
  // TEMPORARY (NWARE-82): a floating switch to compare the frame flicker's 0.2 / 0.25 s beat
  // (contact-terminal.css) and replay it in place. Deleted with the losing beat before the merge.
  {
    const panel = document.createElement('div');
    panel.style.cssText =
      'position:fixed;left:12px;bottom:12px;z-index:99;display:flex;gap:6px;font:500 12px monospace';
    for (const beat of ['20', '25']) {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = `beat 0.${beat} s`;
      button.style.cssText =
        'padding:6px 10px;border:1px solid #444;border-radius:6px;background:#111;color:#eee;cursor:pointer';
      button.addEventListener('click', () => {
        document.documentElement.dataset.beat = beat;
        // The click took focus out of the form; focusing it again replays the flicker.
        document.querySelector<HTMLElement>('[data-contact] input')?.focus({ preventScroll: true });
      });
      panel.append(button);
    }
    document.body.append(panel);
  }
</script>
