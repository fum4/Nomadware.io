---
import { BUILD_INFO } from '../config/build-info';
import { SITE } from '../config/site';
import RelativeTime from './relative-time.astro';

interface Props {
  renderedAt: string;
}
const { renderedAt } = Astro.props;
---

<!-- data-commit: the deployed commit, for debugging only (not shown; "dev" off Vercel). -->
<footer class="footer" data-commit={BUILD_INFO.sha}>
  <p class="studio">
    <span class="owner">© {BUILD_INFO.year} {SITE.name}</span><span class="sep" aria-hidden="true"> · </span><span>no overhead · just software</span>
  </p>
  <p>
    last deploy <RelativeTime iso={BUILD_INFO.builtAt} renderedAt={renderedAt} /><span class="privacy"
      > · <button type="button" data-consent-open>privacy</button></span
    >
  </p>
</footer>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    /* One grid cell more than the base gap, so the contact form has room to breathe. */
    margin-top: calc(48px + var(--grid));
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font: 400 11px/var(--leading) var(--mono);
    color: var(--dim);
  }

  p {
    margin: 0;
  }

  .owner {
    color: var(--fg);
  }

  /* Reopens the consent banner (withdrawing consent must be as easy as giving it); looks like
     the footer's text, not a button. */
  .privacy button {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    transition: color 0.15s;
  }

  .privacy button:hover {
    color: var(--fg);
  }

  /* No JS, no analytics: nothing to reopen. */
  :global(html:not(.js)) .privacy {
    display: none;
  }

  @media (max-width: 640px) {
    /* Two rows: owner · tagline / deploy · privacy. */
    .footer {
      flex-direction: column;
      gap: 14px;
      margin-top: calc(36px + var(--grid) * 0.75);
    }

    .studio {
      white-space: nowrap;
    }
  }

  /* The first row is 322px at 11px, which needs a 362px screen; below 370px it steps down
     (283px) so it stays on one line down to a 330px screen. */
  @media (max-width: 370px) {
    .footer {
      font-size: 10px;
      letter-spacing: -0.02em;
    }
  }
</style>
