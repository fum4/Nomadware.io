---
import { BUILD_INFO } from '../config/build-info';
import { SITE } from '../config/site';
import RelativeTime from './relative-time.astro';
---

<footer class="footer">
  <p class="studio">
    <span class="owner">© {BUILD_INFO.year} {SITE.name}</span><span class="sep" aria-hidden="true"> · </span><span>no office · no overhead · just software</span>
  </p>
  <p>
    last deploy <RelativeTime iso={BUILD_INFO.builtAt} renderedAt={BUILD_INFO.builtAt} /> · <span
      class="sha">{BUILD_INFO.sha}</span
    ><span class="privacy"> · <button type="button" data-consent-open>privacy</button></span>
  </p>
</footer>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font: 400 11px/var(--leading) var(--mono);
    color: var(--dim);
  }

  p {
    margin: 0;
  }

  .owner,
  .sha {
    color: var(--fg);
  }

  /* Reopens the consent banner; looks like the footer's text, not a button. */
  .privacy button {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    transition: color 0.15s;
  }

  .privacy button:hover {
    color: var(--fg);
  }

  /* No JS, no analytics: nothing to reopen. */
  :global(html:not(.js)) .privacy {
    display: none;
  }

  @media (max-width: 640px) {
    /* Three rows: owner / tagline / deploy. */
    .footer,
    .studio {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .footer {
      margin-top: 36px;
    }

    .sep {
      display: none;
    }
  }
</style>
