---
// TEMPORARY (NWARE-82) variant d, "Heartbeat": the window's agent activity as a seismograph line,
// drawn left to right on reveal, the busiest moment and the latest one called out on the line,
// the stats as a compact legend underneath.
import { STAT_WINDOWS } from '@nomadware/site-stats';

import type { LoadedStats } from '../../data/load-stats';
import { STATS_SERIES } from '../../data/load-series';
import { DEFAULT_STAT_WINDOW } from '../../data/stats-snapshot';
import RelativeTime from '../relative-time.astro';
import StatValue from '../stat-value.astro';
import { linePath, peakOf } from './spark-path';

interface Props {
  stats: LoadedStats;
  renderedAt: string;
}
const { stats, renderedAt } = Astro.props;
const { snapshot, source } = stats;
const W = 1000;
const H = 140;
const charts = STAT_WINDOWS.map((range) => {
  const values = STATS_SERIES?.agentMinutes[range] ?? [];
  const peak = peakOf(values);
  const max = Math.max(1, ...values);
  return {
    range,
    path: linePath(values, W, H),
    // Callout positions in % of the chart box, so they follow the SVG's stretch.
    // Kept off the edges so the label never hangs outside the card.
    peakX: Math.min(85, Math.max(15, values.length > 1 ? (peak.index / (values.length - 1)) * 100 : 0)),
    peakY: 100 - (peak.value / max) * 100,
    peakHours: Math.round(peak.value / 60),
    bucketHours: range === '7d' ? 2 : 6,
  };
});
---

<section class="beat" aria-labelledby="stats-title" data-stats data-stats-source={source}>
  <h2 id="stats-title" class="sr-only">What the studio shipped</h2>
  <div class="head">
    <span>agent activity · last</span>
    <span class="seg" role="group" aria-label="Time range">
      {
        STAT_WINDOWS.map((range) => (
          <button
            type="button"
            data-range={range}
            aria-pressed={range === DEFAULT_STAT_WINDOW ? 'true' : 'false'}
          >
            {range}
          </button>
        ))
      }
    </span>
    <span class="live"
      ><span class="dot" aria-hidden="true"></span>updated <RelativeTime
        iso={snapshot.generatedAt}
        renderedAt={renderedAt}
      /></span
    >
  </div>
  <div class="chart" aria-hidden="true">
    {
      charts.map((chart) => (
        <div
          class="plot"
          data-range-label={chart.range}
          data-current={chart.range === DEFAULT_STAT_WINDOW ? '' : undefined}
        >
          <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
            <path class="trace" d={chart.path} pathLength="1" />
          </svg>
          <span class="callout" style={`left: ${chart.peakX}%; top: ${chart.peakY}%`}>
            peak · {chart.peakHours}h of agent work in {chart.bucketHours}h
          </span>
          <span class="now">now</span>
        </div>
      ))
    }
  </div>
  <dl class="legend">
    <div><dt>PRs merged</dt><dd><StatValue stat="prs" snapshot={snapshot} /></dd></div>
    <div><dt>agent runs</dt><dd><StatValue stat="runs" snapshot={snapshot} /></dd></div>
    <div><dt>agent-hours</dt><dd><StatValue stat="agentHours" snapshot={snapshot} /></dd></div>
    <div><dt>tool calls</dt><dd><StatValue stat="actions" snapshot={snapshot} /></dd></div>
    <div><dt>checks</dt><dd><StatValue stat="checks" snapshot={snapshot} /></dd></div>
    <div class="warm"><dt>issues caught</dt><dd><StatValue stat="caught" snapshot={snapshot} /></dd></div>
  </dl>
</section>

<style>
  .beat {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--term);
    overflow: hidden;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--line);
    font: 400 11px/var(--leading) var(--mono);
    color: var(--dim);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .live {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    letter-spacing: 0;
    text-transform: none;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sig);
  }

  .seg {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .seg button {
    padding: 3px 8px;
    border: 0;
    background: none;
    color: var(--dim);
    font: 500 10px/var(--leading) var(--mono);
    cursor: pointer;
  }

  .seg button[aria-pressed='true'] {
    background: var(--chip);
    color: var(--fg);
  }

  /* Paper ruled like a seismograph: the page grid's own cell, finer. */
  .chart {
    position: relative;
    height: 180px;
    margin: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  .plot {
    position: absolute;
    inset: 24px 24px 16px;
  }

  .plot:not([data-current]) {
    display: none;
  }

  svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Drawn left → right whenever it is shown (display: none → block restarts the animation). */
  .trace {
    fill: none;
    stroke: var(--sig);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: trace-draw 1.6s cubic-bezier(0.3, 0, 0.2, 1) 0.2s forwards;
    filter: drop-shadow(0 0 4px var(--sig-glow));
  }

  @keyframes trace-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .callout,
  .now {
    position: absolute;
    font: 400 11px/var(--leading) var(--mono);
    white-space: nowrap;
  }

  .callout {
    transform: translate(-50%, -150%);
    padding: 2px 6px;
    border: 1px solid var(--sig-soft);
    border-radius: 4px;
    background: var(--ink);
    color: var(--fg);
  }

  .now {
    right: -4px;
    bottom: -14px;
    color: var(--faint);
  }

  .legend {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .legend div {
    display: flex;
    flex-direction: column-reverse;
    padding: 14px 18px;
    border-right: 1px solid var(--line);
  }

  .legend div:last-child {
    border-right: 0;
  }

  .legend dt {
    font: 400 11px/var(--leading) var(--mono);
    color: var(--dim);
    white-space: nowrap;
  }

  .legend dd {
    margin: 0;
    font: 500 22px/var(--leading) var(--sans);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .legend .warm dd,
  .legend .warm dt {
    color: var(--warm);
  }

  @media (max-width: 640px) {
    .head {
      flex-wrap: wrap;
      padding: 11px 14px;
    }

    /* Its own row on phones, whatever the font: a wrap that depends on glyph widths shifts the
       card when the web font swaps in. */
    .live {
      flex-basis: 100%;
      margin-left: 0;
    }

    .chart {
      height: 150px;
    }

    .plot {
      inset: 30px 14px 16px;
    }

    .legend {
      grid-template-columns: repeat(3, 1fr);
    }

    .legend div {
      padding: 12px 14px;
    }

    .legend div:nth-child(3n) {
      border-right: 0;
    }

    .legend div:nth-child(-n + 3) {
      border-bottom: 1px solid var(--line);
    }

    .legend dd {
      font-size: 18px;
    }

    .legend dt {
      font-size: 10px;
    }
  }
</style>
