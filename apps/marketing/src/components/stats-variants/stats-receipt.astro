---
// TEMPORARY (NWARE-82) variant e, "Receipt": the window's output as a slightly tilted thermal
// receipt, perforated on top and torn at the bottom, printing in line by line when it scrolls in.
import { STAT_WINDOWS } from '@nomadware/site-stats';

import type { LoadedStats } from '../../data/load-stats';
import { DEFAULT_STAT_WINDOW } from '../../data/stats-snapshot';
import RelativeTime from '../relative-time.astro';
import StatValue from '../stat-value.astro';

interface Props {
  stats: LoadedStats;
  renderedAt: string;
}
const { stats, renderedAt } = Astro.props;
const { snapshot, source } = stats;
// A fixed pseudo-random barcode (decorative): bar and gap widths in px.
const BARS = Array.from({ length: 46 }, (_, index) => 1 + ((index * 7 + 3) % 4));
---

<section class="receipt-wrap" aria-labelledby="stats-title" data-stats data-stats-source={source}>
  <h2 id="stats-title" class="sr-only">What the studio shipped</h2>
  <div class="receipt" data-receipt>
    <p class="brand">NOMADWARE</p>
    <p class="sub">
      LAST
      <span class="seg" role="group" aria-label="Time range">
        {
          STAT_WINDOWS.map((range) => (
            <button
              type="button"
              data-range={range}
              aria-pressed={range === DEFAULT_STAT_WINDOW ? 'true' : 'false'}
            >
              {Number.parseInt(range, 10)}
            </button>
          ))
        }
      </span>
      DAYS
    </p>
    <p class="meta">printed <RelativeTime iso={snapshot.generatedAt} renderedAt={renderedAt} /></p>
    <dl class="items">
      <div><dt>PULL REQUESTS MERGED</dt><dd><StatValue stat="prs" snapshot={snapshot} /></dd></div>
      <div><dt>AGENT RUNS</dt><dd><StatValue stat="runs" snapshot={snapshot} /></dd></div>
      <div><dt>AGENT-HOURS</dt><dd><StatValue stat="agentHours" snapshot={snapshot} /></dd></div>
      <div><dt>TOOL CALLS</dt><dd><StatValue stat="actions" snapshot={snapshot} /></dd></div>
      <div><dt>CHECKS RUN</dt><dd><StatValue stat="checks" snapshot={snapshot} /></dd></div>
      <div><dt>LINES ADDED</dt><dd>+<StatValue stat="linesAdded" snapshot={snapshot} /></dd></div>
      <div>
        <dt>LINES REMOVED</dt><dd>−<StatValue stat="linesDeleted" snapshot={snapshot} /></dd>
      </div>
    </dl>
    <dl class="total">
      <div><dt>TOTAL ISSUES CAUGHT</dt><dd><StatValue stat="caught" snapshot={snapshot} /></dd></div>
    </dl>
    <p class="barcode" aria-hidden="true">
      {BARS.map((width, index) => <i style={`width: ${width}px; opacity: ${index % 2}`} />)}
    </p>
    <p class="thanks">thank you for building with us</p>
  </div>
</section>

<script>
  import { onceVisible } from '../../scripts/motion';
  // Prints in once, when it scrolls into view.
  const receipt = document.querySelector<HTMLElement>('[data-receipt]');
  if (receipt) onceVisible(receipt, 0.3, () => receipt.classList.add('is-printed'));
</script>

<style>
  .receipt-wrap {
    display: flex;
    justify-content: center;
    padding: 12px 0 24px;
  }

  .receipt {
    --edge: 8px;

    width: min(420px, 100%);
    padding: 26px 26px 34px;
    background:
      repeating-linear-gradient(0deg, transparent 0 3px, rgba(0, 0, 0, 0.018) 3px 4px),
      var(--paper);
    color: var(--paper-ink);
    font: 500 12.5px/1.7 var(--mono);
    letter-spacing: 0.04em;
    transform: rotate(-1.4deg);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5);
    /* Perforated top (a row of punched holes), torn zigzag bottom. */
    mask:
      radial-gradient(circle at 50% 0, transparent 3px, #000 3.5px) top / 12px 12px repeat-x,
      linear-gradient(#000, #000) 0 12px / 100% calc(100% - 12px - var(--edge)) no-repeat,
      conic-gradient(from -45deg at 50% 100%, transparent 90deg, #000 0) bottom / 12px var(--edge)
        repeat-x;
  }

  p {
    margin: 0;
  }

  .brand {
    text-align: center;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.3em;
  }

  .sub,
  .meta {
    text-align: center;
    color: var(--paper-faint);
  }

  .meta {
    margin-bottom: 14px;
    padding-bottom: 14px;
    border-bottom: 1px dashed var(--paper-faint);
    font-size: 11px;
  }

  .seg {
    display: inline-flex;
    gap: 2px;
  }

  .seg button {
    padding: 0 5px;
    border: 1px solid transparent;
    background: none;
    color: var(--paper-faint);
    font: inherit;
    cursor: pointer;
  }

  .seg button[aria-pressed='true'] {
    border-color: var(--paper-ink);
    color: var(--paper-ink);
  }

  dl {
    margin: 0;
  }

  dl div {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  /* The item fills the line; a dotted leader runs from its name to the amount. */
  dt {
    display: flex;
    flex: 1;
    gap: 6px;
  }

  dt::after {
    content: '';
    flex: 1;
    margin-bottom: 0.35em;
    border-bottom: 2px dotted var(--paper-faint);
  }

  dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .total {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px dashed var(--paper-faint);
    font-weight: 700;
    font-size: 14px;
  }

  .barcode {
    display: flex;
    justify-content: center;
    height: 40px;
    margin: 20px 0 6px;
  }

  .barcode i {
    background: var(--paper-ink);
  }

  .thanks {
    text-align: center;
    color: var(--paper-faint);
    font-size: 11px;
  }

  /* Prints in: each line slides down from the print head, one after another. */
  .receipt > *,
  .receipt dl > div {
    opacity: 0;
    transform: translateY(-6px);
  }

  .receipt:global(.is-printed) > *,
  .receipt:global(.is-printed) dl > div {
    animation: receipt-print 0.28s ease-out forwards;
  }

  .receipt:global(.is-printed) > :nth-child(2) {
    animation-delay: 0.08s;
  }

  .receipt:global(.is-printed) > :nth-child(3) {
    animation-delay: 0.16s;
  }

  .receipt:global(.is-printed) .items > div:nth-child(1) {
    animation-delay: 0.24s;
  }

  .receipt:global(.is-printed) .items > div:nth-child(2) {
    animation-delay: 0.32s;
  }

  .receipt:global(.is-printed) .items > div:nth-child(3) {
    animation-delay: 0.4s;
  }

  .receipt:global(.is-printed) .items > div:nth-child(4) {
    animation-delay: 0.48s;
  }

  .receipt:global(.is-printed) .items > div:nth-child(5) {
    animation-delay: 0.56s;
  }

  .receipt:global(.is-printed) .items > div:nth-child(6) {
    animation-delay: 0.64s;
  }

  .receipt:global(.is-printed) .items > div:nth-child(7) {
    animation-delay: 0.72s;
  }

  .receipt:global(.is-printed) > .total,
  .receipt:global(.is-printed) .total > div {
    animation-delay: 0.84s;
  }

  .receipt:global(.is-printed) > .barcode {
    animation-delay: 0.96s;
  }

  .receipt:global(.is-printed) > .thanks {
    animation-delay: 1.04s;
  }

  /* The list wrappers themselves show at once; their lines carry the stagger. */
  .receipt:global(.is-printed) > .items {
    animation-duration: 0s;
  }

  @keyframes receipt-print {
    to {
      opacity: 1;
      transform: none;
    }
  }

  :global(html:not(.js)) .receipt > *,
  :global(html:not(.js)) .receipt dl > div {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 640px) {
    .receipt {
      padding: 22px 18px 30px;
      font-size: 11.5px;
      transform: rotate(-0.8deg);
    }
  }
</style>
