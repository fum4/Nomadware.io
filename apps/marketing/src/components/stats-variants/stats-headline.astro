---
// TEMPORARY (NWARE-82) variant a, "Headline number": one huge number (PRs merged) with a 30-day
// sparkline of merged PRs per day, the rest as a slim row of inline pairs.
import { STAT_WINDOWS } from '@nomadware/site-stats';

import type { LoadedStats } from '../../data/load-stats';
import { STATS_SERIES } from '../../data/load-series';
import { DEFAULT_STAT_WINDOW } from '../../data/stats-snapshot';
import RelativeTime from '../relative-time.astro';
import StatValue from '../stat-value.astro';
import { areaPath, linePath } from './spark-path';

interface Props {
  stats: LoadedStats;
  renderedAt: string;
}
const { stats, renderedAt } = Astro.props;
const { snapshot, source } = stats;
const days = (range: string): string => `${Number.parseInt(range, 10)} days`;
const W = 600;
const H = 56;
const series = STATS_SERIES?.prsPerDay;
---

<section class="headline" aria-labelledby="stats-title" data-stats data-stats-source={source}>
  <h2 id="stats-title" class="sr-only">What the studio shipped</h2>
  <div class="top">
    <p class="big"><StatValue stat="prs" snapshot={snapshot} /></p>
    <div class="caption">
      <p>
        pull requests merged in the last
        <span class="seg" role="group" aria-label="Time range">
          {
            STAT_WINDOWS.map((range) => (
              <button
                type="button"
                data-range={range}
                aria-pressed={range === DEFAULT_STAT_WINDOW ? 'true' : 'false'}
              >
                {days(range)}
              </button>
            ))
          }
        </span>
      </p>
      <p class="live">
        <span class="dot" aria-hidden="true"></span>updated <RelativeTime
          iso={snapshot.generatedAt}
          renderedAt={renderedAt}
        />
      </p>
    </div>
  </div>
  {
    series && (
      <svg class="spark" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
        {STAT_WINDOWS.map((range) => (
          <g
            data-range-label={range}
            data-current={range === DEFAULT_STAT_WINDOW ? '' : undefined}
          >
            <path class="area" d={areaPath(series[range], W, H)} />
            <path class="line" d={linePath(series[range], W, H)} />
          </g>
        ))}
      </svg>
    )
  }
  <dl class="row">
    <div><dt>agent runs</dt><dd><StatValue stat="runs" snapshot={snapshot} /></dd></div>
    <div><dt>agent-hours</dt><dd><StatValue stat="agentHours" snapshot={snapshot} />h</dd></div>
    <div><dt>tool calls</dt><dd><StatValue stat="actions" snapshot={snapshot} /></dd></div>
    <div><dt>checks</dt><dd><StatValue stat="checks" snapshot={snapshot} /></dd></div>
    <div class="warm">
      <dt>issues caught</dt><dd><StatValue stat="caught" snapshot={snapshot} /></dd>
    </div>
    <div>
      <dt>lines</dt><dd>
        +<StatValue stat="linesAdded" snapshot={snapshot} /> −<StatValue
          stat="linesDeleted"
          snapshot={snapshot}
        />
      </dd>
    </div>
  </dl>
</section>

<style>
  .headline {
    padding: 28px 28px 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    backdrop-filter: blur(6px);
  }

  .top {
    display: flex;
    align-items: flex-end;
    gap: 24px;
  }

  .big {
    margin: 0;
    font: 500 96px/0.9 var(--sans);
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }

  .caption p {
    margin: 0;
  }

  .caption {
    display: grid;
    gap: 8px;
    padding-bottom: 8px;
    font: 400 13px/var(--leading) var(--mono);
    color: var(--dim);
  }

  .seg {
    display: inline-flex;
    margin-left: 6px;
    vertical-align: middle;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .seg button {
    padding: 2px 8px;
    border: 0;
    background: none;
    color: var(--dim);
    font: 500 11px/var(--leading) var(--mono);
    cursor: pointer;
  }

  .seg button[aria-pressed='true'] {
    background: var(--chip);
    color: var(--fg);
  }

  .live {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sig);
  }

  .spark {
    display: block;
    width: 100%;
    height: 56px;
    margin: 22px 0 18px;
    overflow: visible;
  }

  .spark g:not([data-current]) {
    display: none;
  }

  .area {
    fill: var(--sig-soft);
    opacity: 0.35;
  }

  .line {
    fill: none;
    stroke: var(--sig);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font: 400 12px/var(--leading) var(--mono);
    color: var(--dim);
  }

  .row div {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  /* Number first on screen, label first in the markup (dt before dd). */
  .row dd {
    order: -1;
    margin: 0;
    color: var(--fg);
    font: 500 15px/var(--leading) var(--sans);
    font-variant-numeric: tabular-nums;
  }

  .row .warm dd,
  .row .warm dt {
    color: var(--warm);
  }

  @media (max-width: 640px) {
    .headline {
      padding: 20px 16px 16px;
    }

    .top {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .big {
      font-size: 72px;
    }

    .row {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
