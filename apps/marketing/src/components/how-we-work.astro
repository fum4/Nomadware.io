---
import PageSection from './page-section.astro';

const PRINCIPLES = [
  {
    title: 'Product mindset',
    subtitle: 'We build for your users, not for the ticket, we ship what moves the needle.',
    detail:
      "Software is for people. A feature only matters if it makes someone's day easier, so that's what we measure our work by. The best products feel obvious to the people using them, and that kind of simple is never an accident.",
  },
  {
    title: 'Always in motion',
    subtitle: 'Agents work around the clock. You wake up to progress, not questions.',
    detail:
      "Most projects don't fail, they stall, so our agents keep the work moving around the clock. We build the pipelines, workflows and guardrails that keep them in check: every change is thoroughly tested, reviewed and gated before it gets out of our lab.",
  },
  {
    title: 'Zero friction',
    subtitle: 'No calls, no tickets to babysit. New builds show up on your phone as they land.',
    detail:
      'Meetings describe progress; a working build shows it. So we send you something you can tap, not something you have to sit through. Your time is better spent running your business than managing us.',
  },
];
---

<PageSection id="how-we-work" title="How we work" band>
  <ul class="rows">
    {
      PRINCIPLES.map(({ title, subtitle, detail }) => (
        <li>
          <h3>{title}</h3>
          <p class="subtitle">{subtitle}</p>
          <p class="detail">{detail}</p>
        </li>
      ))
    }
  </ul>
</PageSection>

<style>
  /* Title → one-liner → the longer why, each a step quieter (same type, colour one step down);
     rows separated by space alone. */
  .rows {
    display: grid;
    gap: 48px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  h3 {
    margin: 0 0 8px;
    font-weight: 500;
    font-size: 24px;
    line-height: var(--leading);
    letter-spacing: -0.02em;
  }

  p {
    max-width: 60ch;
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
  }

  .subtitle {
    color: var(--dim);
  }

  .detail {
    margin-top: 10px;
    color: var(--subdued);
  }

  @media (max-width: 640px) {
    .rows {
      gap: 36px;
    }

    h3 {
      font-size: 20px;
    }
  }
</style>
