---
import { HWW_LAYOUT } from '../constants';
import DetailText from './how-we-work/detail-text.astro';
import HwwCircuit from './how-we-work/hww-circuit.astro';
import HwwConfig from './how-we-work/hww-config.astro';
import HwwIndex from './how-we-work/hww-index.astro';
import HwwStatements from './how-we-work/hww-statements.astro';
import HwwTabs from './how-we-work/hww-tabs.astro';
import { PRINCIPLES } from './how-we-work/principles';
import PageSection from './page-section.astro';

// TEMPORARY (NWARE-82): `?hww=1..5` renders one of the layout directions under review; anything
// else renders today's stacked rows.
const requested = Number(Astro.url.searchParams.get(HWW_LAYOUT.param));
const variant = Number.isInteger(requested) && requested >= 1 && requested <= HWW_LAYOUT.count ? requested : 0;
---

<!-- One extra cell above: more air under the stats card. -->
<PageSection id="how-we-work" title="How we work" band extraCells={1}>
  {variant === 1 && <HwwIndex />}
  {variant === 2 && <HwwTabs />}
  {variant === 3 && <HwwConfig />}
  {variant === 4 && <HwwCircuit />}
  {variant === 5 && <HwwStatements />}
  {
    variant === 0 && (
      <ul class="rows">
        {PRINCIPLES.map(({ title, subtitle, detail }) => (
          <li>
            <h3>{title}</h3>
            <p class="subtitle">{subtitle}</p>
            <p class="detail">
              <DetailText runs={detail} />
            </p>
          </li>
        ))}
      </ul>
    )
  }
</PageSection>

<style>
  /* Title → one-liner → the longer why, each a step quieter (same type, colour steps down);
     rows separated by space alone. */
  .rows {
    display: grid;
    gap: 48px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  h3 {
    margin: 0 0 8px;
    font-weight: 500;
    font-size: 24px;
    line-height: var(--leading);
    letter-spacing: -0.02em;
  }

  /* pretty: the browser avoids a lone word on the last line (no-op where unsupported). */
  p {
    max-width: 60ch;
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .subtitle {
    color: var(--soft);
  }

  /* 3ch wider than the subtitle: sets the longest detail (Product mindset) in three lines at
     desktop widths. 62.5ch is the threshold; 63ch leaves ~4px across font renderers. */
  .detail {
    max-width: 63ch;
    margin-top: 10px;
    color: var(--subdued);
  }

  @media (max-width: 640px) {
    /* Stacked, each row is long: the space between them has to do the dividing. */
    .rows {
      gap: 96px;
    }

    h3 {
      font-size: 20px;
    }
  }
</style>
