---
import PageSection from './page-section.astro';

// `detail` is a list of runs; every second run (odd index) is set in italics.
const PRINCIPLES = [
  {
    title: 'Product mindset',
    subtitle: 'We build for our users. We ship what moves the needle.',
    detail: [
      "A feature only matters if it makes someone's day easier, so that's what we measure our work by. The best products disappear into someone's routine. They feel obvious, they just work — that kind of ",
      'simple',
      ' is never an accident.',
    ],
  },
  {
    title: 'Always in motion',
    subtitle: 'Agents work around the clock. Every morning starts with progress.',
    detail: [
      "Most projects don't fail, they ",
      'stall',
      ', so our agents keep the work moving around the clock. We build the pipelines, workflows and guardrails that keep them in check. Our harness delivers continuously and ensures every change is proven before it gets out of our lab.',
    ],
  },
  {
    title: 'Zero friction',
    subtitle: 'Every change goes from idea to production in one continuous, elegant flow.',
    detail: [
      'Most delays live in the ',
      'gaps',
      " between people. We closed them with knowledge and tools: every decision, rule and piece of context sits within our agents' reach — they never wait on an answer. The same trail lets us observe, step in and steer, with the right information a glance away.",
    ],
  },
];

const number = (index: number): string => String(index + 1).padStart(2, '0');
---

<!-- One extra cell above: more air under the stats card. -->
<PageSection id="how-we-work" title="How we work" band extraCells={1}>
  <div class="track" data-principles>
    <div class="stage" data-principles-stage>
      <div class="list" role="tablist" aria-label="Principles" aria-orientation="vertical">
        {
          PRINCIPLES.map(({ title }, index) => (
            <button
              class="tab"
              type="button"
              role="tab"
              id={`principle-tab-${index}`}
              aria-controls={`principle-${index}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              data-principle-tab
            >
              <span class="tab-num">{number(index)}</span>
              <span class="tab-name">{title}</span>
              <span class="bar" aria-hidden="true" data-principle-bar />
            </button>
          ))
        }
      </div>
      <div class="panels">
        {
          PRINCIPLES.map(({ title, subtitle, detail }, index) => (
            <div
              class:list={['panel', { 'is-active': index === 0 }]}
              role="tabpanel"
              id={`principle-${index}`}
              aria-labelledby={`principle-tab-${index}`}
              data-principle-panel
            >
              <p class="count" aria-hidden="true">
                <span>{number(index)}</span> / {number(PRINCIPLES.length - 1)}
              </p>
              <h3>{title}</h3>
              <p class="subtitle">{subtitle}</p>
              <p class="detail">
                {detail.map((run, runIndex) => (runIndex % 2 === 1 ? <em>{run}</em> : run))}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</PageSection>

<script>
  import { initPrincipleSwitcher } from '../scripts/principle-switcher';
  initPrincipleSwitcher();
</script>

<style>
  /* Stacked (no JS, short viewports): no tab list, each principle with its own title,
     title → one-liner → the longer why, each a step quieter. */
  .list,
  .count {
    display: none;
  }

  .panels {
    display: grid;
    gap: 48px;
  }

  h3 {
    margin: 0 0 8px;
    font-weight: 500;
    font-size: 24px;
    line-height: var(--leading);
    letter-spacing: -0.02em;
  }

  /* pretty: the browser avoids a lone word on the last line (no-op where unsupported). */
  p {
    margin: 0;
    text-wrap: pretty;
  }

  .subtitle {
    max-width: 60ch;
    font-size: 14px;
    line-height: 1.55;
    color: var(--soft);
  }

  .detail {
    max-width: 63ch;
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--subdued);
  }

  @media (max-width: 640px) {
    /* Stacked, each row is long: the space between them has to do the dividing. */
    .panels {
      gap: 96px;
    }

    h3 {
      font-size: 20px;
    }
  }

  /* Pinned: `is-pinned`, set by principle-switcher.ts where the viewport is tall enough
     (principle-pin.ts; a class, not a media query, so an on-screen keyboard can't unpin it), so
     with JS only. The stage IS the band: the section's own band (page-section.astro) is off, and
     the stage paints the page behind a band itself, opaque, full-bleed (::before): ink, grid
     paper, column halo (global.css --column-halo), band tint. Its top sits on a grid line
     (principle-switcher.ts: --snap), so its grid lines are the page's. Its height (--stage-h: the
     viewport, phones the screen, rounded up to whole cells) and the track's scroll (--track-room:
     whole cells) are px set by principle-switcher.ts, never viewport units: a phone's toolbars
     change those mid-scroll. While pinned nothing behind it shows, the desktop's grid canvas
     included; at release the stage's lines are on the page's again.
     No ancestor of the stage may clip (overflow other than visible, `clip` included): under a
     clipping ancestor iOS WebKit re-pins a sticky element out of step while the toolbars resize
     the viewport, and the stage jitters up and down as the visitor scrolls. So nothing on the
     page reaches past it sideways instead (global.css .frame). */
  :global(html.js #how-we-work.is-band:has(.is-pinned)::before) {
    display: none;
  }

  :global(html.js) .track.is-pinned {
    margin-top: var(--snap, 0px);
  }

  :global(html.js) .track.is-pinned::after {
    content: '';
    display: block;
    height: var(--track-room);
  }

  :global(html.js) .is-pinned .stage {
    position: sticky;
    top: 0;
    display: grid;
    grid-template-columns: calc(var(--grid) * 5) minmax(0, 1fr);
    gap: calc(var(--grid) * 1.5);
    align-items: center;
    align-content: center;
    height: var(--stage-h);
    padding-bottom: calc(var(--stage-h) - var(--visible-h));
  }

  :global(html.js) .is-pinned .stage::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--bleed-left, calc(50% - 50vw));
    z-index: -1;
    width: var(--bleed-width, 100vw);
    height: 100%;
    background-color: var(--ink);
    background-image:
      linear-gradient(var(--band), var(--band)),
      var(--column-halo),
      linear-gradient(var(--grid-color) var(--grid-line), transparent var(--grid-line)),
      linear-gradient(90deg, var(--grid-color) var(--grid-line), transparent var(--grid-line));
    background-size:
      auto,
      auto,
      var(--grid) var(--grid),
      var(--grid) var(--grid);
  }

  :global(html.js) .is-pinned .list {
    display: grid;
    border-left: 1px solid var(--line);
  }

  :global(html.js) .is-pinned .panels {
    gap: 0;
  }

  /* All three in one cell: the stage is as tall as the tallest, whichever shows. */
  :global(html.js) .is-pinned .panel {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.2s,
      transform 0.2s,
      visibility 0s 0.2s;
  }

  :global(html.js) .is-pinned .panel.is-active {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
      opacity 0.28s 0.06s,
      transform 0.28s 0.06s;
  }

  :global(html.js) .is-pinned .count {
    display: block;
    margin-bottom: 20px;
    font: 400 11px/var(--leading) var(--mono);
    letter-spacing: 0.12em;
    color: var(--dim);
  }

  :global(html.js) .is-pinned .count span {
    color: var(--sig);
  }

  /* The tab names the principle; screen readers still get it in the panel. */
  :global(html.js) .is-pinned h3 {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  :global(html.js) .is-pinned .subtitle {
    max-width: 18ch;
    font-weight: 500;
    font-size: 48px;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--fg);
  }

  :global(html.js) .is-pinned .detail {
    max-width: 56ch;
    margin-top: 24px;
    font-size: 15px;
    line-height: 1.6;
  }

  /* Phones, pinned: the tabs as a row of numbers near the top (the title shows in the panel), the
     current one's bar along its bottom. */
  @media (max-width: 640px) {
    :global(html.js) .is-pinned .stage {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
      align-content: start;
      padding-top: calc(var(--grid) * 2);
    }

    :global(html.js) .is-pinned .list {
      grid-template-columns: repeat(3, 1fr);
      border-left: 0;
      border-bottom: 1px solid var(--line);
    }

    :global(html.js) .is-pinned .tab {
      grid-template-columns: auto;
      justify-content: center;
      padding: 14px 0;
    }

    :global(html.js) .is-pinned .tab-num {
      font-size: 13px;
    }

    :global(html.js) .is-pinned .tab-name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    :global(html.js) .is-pinned .bar {
      top: auto;
      bottom: -1px;
      left: 0;
      width: 100%;
      height: 1px;
      transform-origin: left;
      transform: scaleX(0);
    }

    :global(html.js) .is-pinned .tab[aria-selected='true'] .bar {
      transform: scaleX(var(--page-progress, 0));
    }

    :global(html.js) .is-pinned .count {
      display: none;
    }

    :global(html.js) .is-pinned h3 {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      white-space: normal;
      margin-bottom: 14px;
      font-size: 13px;
      font-family: var(--mono);
      font-weight: 400;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--sig);
    }

    :global(html.js) .is-pinned .subtitle {
      font-size: 30px;
      line-height: 1.1;
    }

    :global(html.js) .is-pinned .detail {
      margin-top: 18px;
      font-size: 14px;
    }
  }

  .tab {
    position: relative;
    display: grid;
    grid-template-columns: 4ch 1fr;
    align-items: baseline;
    padding: 20px 0 20px 24px;
    border: 0;
    background: none;
    color: var(--faint);
    text-align: start;
    cursor: pointer;
    transition: color 0.3s;
  }

  .tab:hover {
    color: var(--soft);
  }

  .tab[aria-selected='true'] {
    color: var(--fg);
  }

  .tab:focus-visible {
    outline-offset: -2px;
  }

  .tab-num {
    font: 400 11px/var(--leading) var(--mono);
    letter-spacing: 0.08em;
  }

  .tab[aria-selected='true'] .tab-num {
    color: var(--sig);
  }

  .tab-name {
    font-weight: 500;
    font-size: 22px;
    line-height: var(--leading);
    letter-spacing: -0.02em;
  }

  /* On the list's left rule, the current tab's marker: how far the scroll is through its page
     (--page-progress 0 → 1, set by principle-switcher.ts). */
  .bar {
    position: absolute;
    top: 0;
    left: -1px;
    width: 1px;
    height: 100%;
    background: var(--sig);
    box-shadow: 0 0 8px var(--sig-glow);
    transform-origin: top;
    transform: scaleY(0);
    /* Its own layer: the scroll moves it every frame without repainting the stage. */
    will-change: transform;
  }

  .tab[aria-selected='true'] .bar {
    transform: scaleY(var(--page-progress, 0));
  }
</style>
