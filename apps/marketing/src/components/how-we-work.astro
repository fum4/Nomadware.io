---
import PageSection from './page-section.astro';

// `detail` is a list of runs; every second run (odd index) is set in italics.
const PRINCIPLES = [
  {
    title: 'Product mindset',
    subtitle: 'We build for our users. We ship what moves the needle.',
    detail: [
      "A feature only matters if it makes someone's day easier, so that's what we measure our work by. The best products disappear into someone's routine. They feel obvious, they just work — that kind of ",
      'simple',
      ' is never an accident.',
    ],
  },
  {
    title: 'Always in motion',
    subtitle: 'Agents work around the clock. Every morning starts with progress.',
    detail: [
      "Most projects don't fail, they stall, so our agents keep the work moving around the clock. We build the pipelines, workflows and guardrails that keep them in check. Our harness delivers continuously and ensures every change is proven before it gets out of our lab.",
    ],
  },
  {
    title: 'Zero friction',
    subtitle: 'Every change goes from idea to production in one motion.',
    detail: [
      'Most delays live in the gaps between people. We closed them with knowledge: every decision, rule and piece of context sits within our agents\' reach. They never stall waiting for an answer. The same trail lets us observe, step in and steer, with the right information a glance away.',
    ],
  },
];
---

<!-- One extra cell above: more air under the stats card. -->
<PageSection id="how-we-work" title="How we work" band extraCells={1}>
  <ul class="rows">
    {
      PRINCIPLES.map(({ title, subtitle, detail }) => (
        <li>
          <h3>{title}</h3>
          <p class="subtitle">{subtitle}</p>
          <p class="detail">{detail.map((run, index) => (index % 2 === 1 ? <em>{run}</em> : run))}</p>
        </li>
      ))
    }
  </ul>
</PageSection>

<style>
  /* Title → one-liner → the longer why, each a step quieter (same type, colour steps down);
     rows separated by space alone. */
  .rows {
    display: grid;
    gap: 48px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  h3 {
    margin: 0 0 8px;
    font-weight: 500;
    font-size: 24px;
    line-height: var(--leading);
    letter-spacing: -0.02em;
  }

  /* pretty: the browser avoids a lone word on the last line (no-op where unsupported). */
  p {
    max-width: 60ch;
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .subtitle {
    color: var(--soft);
  }

  /* 3ch wider than the subtitle: sets the longest detail (Product mindset) in three lines at
     desktop widths. 62.5ch is the threshold; 63ch leaves ~4px across font renderers. */
  .detail {
    max-width: 63ch;
    margin-top: 10px;
    color: var(--subdued);
  }

  @media (max-width: 640px) {
    /* Stacked, each row is long: the space between them has to do the dividing. */
    .rows {
      gap: 96px;
    }

    h3 {
      font-size: 20px;
    }
  }
</style>
