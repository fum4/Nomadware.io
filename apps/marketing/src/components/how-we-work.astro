---
import PageSection from './page-section.astro';

// `detail` is a list of runs; every second run (odd index) is set in italics.
const PRINCIPLES = [
  {
    title: 'Product mindset',
    subtitle: 'We build for our users, not for the ticket, we ship what moves the needle.',
    detail: [
      "Software is for people. A feature only matters if it makes someone's day easier, so that's what we measure our work by. The best products disappear into someone's routine — they feel obvious, they just work — and that kind of ",
      'simple',
      ' is never an accident.',
    ],
  },
  {
    title: 'Always in motion',
    subtitle: 'We work while you sleep, so every morning starts with progress.',
    detail: [
      "Most projects don't fail, they stall, so our agents keep the work moving around the clock. We build the pipelines, workflows and guardrails that keep them in check: every change is rigorously tested, reviewed and gated before it gets out of our lab.",
    ],
  },
  {
    title: 'Zero friction',
    subtitle: 'No calls, no tickets to babysit. New builds show up on your phone as they land.',
    detail: [
      'Meetings describe progress; a working build shows it. So we focus on builds you can tap, not meetings you have to sit through. Your time is better spent running your business than managing us.',
    ],
  },
];
---

<!-- One extra cell above: more air under the stats card. -->
<PageSection id="how-we-work" title="How we work" band extraCells={1}>
  <ul class="rows">
    {
      PRINCIPLES.map(({ title, subtitle, detail }) => (
        <li>
          <h3>{title}</h3>
          <p class="subtitle">{subtitle}</p>
          <p class="detail">{detail.map((run, index) => (index % 2 === 1 ? <em>{run}</em> : run))}</p>
        </li>
      ))
    }
  </ul>
</PageSection>

<style>
  /* Title → one-liner → the longer why, each a step quieter (same type, colour steps down);
     rows separated by space alone. */
  .rows {
    display: grid;
    gap: 48px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  h3 {
    margin: 0 0 8px;
    font-weight: 500;
    font-size: 24px;
    line-height: var(--leading);
    letter-spacing: -0.02em;
  }

  p {
    max-width: 60ch;
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
  }

  .subtitle {
    color: var(--soft);
  }

  /* 1ch wider than the subtitle: the smallest step that sets each detail in three lines at
     desktop widths (60.25ch would do, with ~2px to spare: too tight across font renderers). */
  .detail {
    max-width: 61ch;
    margin-top: 10px;
    color: var(--subdued);
  }

  @media (max-width: 640px) {
    .rows {
      gap: 36px;
    }

    h3 {
      font-size: 20px;
    }
  }
</style>
