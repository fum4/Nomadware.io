---
// TEMPORARY (NWARE-82) direction 3, "principles.yml": the principles as a config file in the
// contact terminal's window chrome (styles/contact-terminal.css), with line numbers and syntax
// colour: title as `name`, the one-liner as `promise`, the detail as a folded `why` block, its
// italic word in warm. The file "prints" line by line the first time it scrolls into view
// (scripts/how-we-work/config-print.ts) and ends on a blinking caret. Phones: same file, smaller
// mono, narrower gutter, the long lines wrapping under their indent.
import { HWW_LAYOUT } from '../../constants';
import DetailText from './detail-text.astro';
import { PRINCIPLES } from './principles';

// Four lines per principle and a blank one between: line numbers in render order.
const LINES_PER_PRINCIPLE = 5;
const firstLine = (index: number): number => index * LINES_PER_PRINCIPLE + 1;
const caretLine = PRINCIPLES.length * LINES_PER_PRINCIPLE;
---

<div
  class="term config"
  data-hww-config
  style={`--stagger: ${HWW_LAYOUT.configLineStaggerMs}ms`}
>
  <div class="term-bar">
    <span class="term-title">
      <span class="term-lights" aria-hidden="true"><span /><span /><span /></span>
      <span class="term-path">~/nware/principles.yml</span>
    </span>
    <span class="meta" aria-hidden="true">yaml · utf-8</span>
  </div>
  <ul class="code">
    {
      PRINCIPLES.map(({ title, subtitle, detail }, index) => {
        const n = firstLine(index);
        return (
          <li>
            <div class="line" style={`--i: ${n}`}>
              <span class="ln" aria-hidden="true">{n}</span>
              {/* One line in source: whitespace between the tokens would print. */}
              <div class="src"><span class="p" aria-hidden="true">- </span><span class="k" aria-hidden="true">name</span><span class="p" aria-hidden="true">: </span><h3>{title}</h3></div>
            </div>
            <div class="line" style={`--i: ${n + 1}`}>
              <span class="ln" aria-hidden="true">{n + 1}</span>
              <div class="src in1"><span class="k" aria-hidden="true">promise</span><span class="p" aria-hidden="true">: "</span><p class="promise">{subtitle}</p><span class="p" aria-hidden="true">"</span></div>
            </div>
            <div class="line" style={`--i: ${n + 2}`} aria-hidden="true">
              <span class="ln">{n + 2}</span>
              <span class="src in1"><span class="k">why</span><span class="p">: &gt;</span></span>
            </div>
            <div class="line" style={`--i: ${n + 3}`}>
              <span class="ln" aria-hidden="true">{n + 3}</span>
              <p class="src in2 why"><DetailText runs={detail} /></p>
            </div>
            {index < PRINCIPLES.length - 1 && (
              <div class="line" style={`--i: ${n + 4}`} aria-hidden="true">
                <span class="ln">{n + 4}</span>
              </div>
            )}
          </li>
        );
      })
    }
  </ul>
  <div class="line" style={`--i: ${caretLine}`} aria-hidden="true">
    <span class="ln">{caretLine}</span>
    <span class="src"><span class="caret"></span></span>
  </div>
</div>

<script>
  import { initConfigPrint } from '../../scripts/how-we-work/config-print';
  initConfigPrint();
</script>

<style>
  .config {
    padding-bottom: 20px;
    font: 400 14px/1.7 var(--mono);
  }

  .meta {
    color: var(--faint);
  }

  .code {
    margin: 0;
    padding: 20px 0 0;
    list-style: none;
  }

  /* Gutter + source; a wrapped source line hangs under its own indent. */
  .line {
    display: grid;
    grid-template-columns: 6ch minmax(0, 1fr);
    column-gap: 2ch;
    min-height: 1.7em;
  }

  .ln {
    color: color-mix(in srgb, var(--faint) 60%, transparent);
    text-align: end;
    font-variant-numeric: tabular-nums;
    user-select: none;
  }

  .src {
    max-width: 96ch;
    margin: 0;
    color: var(--soft);
    text-wrap: pretty;
  }

  .in1 {
    padding-left: 2ch;
  }

  .in2 {
    padding-left: 4ch;
  }

  .k {
    color: var(--sig);
  }

  .p {
    color: var(--faint);
  }

  h3,
  .promise {
    display: inline;
    margin: 0;
    font: inherit;
  }

  h3 {
    font-weight: 600;
    color: var(--fg);
  }

  .promise {
    color: var(--soft);
  }

  .why {
    color: var(--subdued);
  }

  .why :global(em) {
    color: var(--warm);
  }

  .caret {
    display: inline-block;
    width: 1ch;
    height: 1.2em;
    vertical-align: -0.2em;
    background: var(--sig);
    box-shadow: 0 0 8px var(--sig-glow);
    animation: hww-blink 1.1s steps(1, end) infinite;
  }

  @keyframes hww-blink {
    50% {
      opacity: 0;
    }
  }

  /* Printed in: dark until config-print.ts marks the file seen (with JS only), then line by line. */
  :global(html.js) .config .line {
    opacity: 0;
    transition: opacity 0.18s calc(var(--i) * var(--stagger));
  }

  :global(html.js) .config:global(.is-printed) .line {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .config {
      font-size: 12px;
    }

    .line {
      grid-template-columns: 2.5ch minmax(0, 1fr);
      column-gap: 1.5ch;
    }

    .in2 {
      padding-left: 2ch;
    }

    .meta {
      display: none;
    }
  }
</style>
