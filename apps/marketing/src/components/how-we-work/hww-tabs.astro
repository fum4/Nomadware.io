---
// TEMPORARY (NWARE-82) direction 2, "Switcher": the three titles as a vertical tab list on the
// left, the chosen principle's one-liner set large on the right with its detail beneath. It moves
// on by itself every HWW_LAYOUT.tabsAdvanceMs (a lime bar fills under the current tab), paused
// while hovered or focused and until scrolled into view; click or ↑↓ / Home / End pick one
// (scripts/how-we-work/tabs.ts). Phones and no-JS: no tabs, the three panels stacked, each with
// its own title.
import { HWW_LAYOUT } from '../../constants';
import DetailText from './detail-text.astro';
import { PRINCIPLES, principleNumber } from './principles';
---

<div class="switch" data-hww-tabs style={`--advance-ms: ${HWW_LAYOUT.tabsAdvanceMs}ms`}>
  <div class="list" role="tablist" aria-label="Principles" aria-orientation="vertical">
    {
      PRINCIPLES.map(({ title }, index) => (
        <button
          class="tab"
          type="button"
          role="tab"
          id={`hww-tab-${index}`}
          aria-controls={`hww-panel-${index}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          data-hww-tab
        >
          <span class="tab-num">{principleNumber(index)}</span>
          <span class="tab-name">{title}</span>
          <span class="bar" aria-hidden="true" data-hww-bar />
        </button>
      ))
    }
  </div>
  <div class="panels">
    {
      PRINCIPLES.map(({ title, subtitle, detail }, index) => (
        <div
          class:list={['panel', { 'is-active': index === 0 }]}
          role="tabpanel"
          id={`hww-panel-${index}`}
          aria-labelledby={`hww-tab-${index}`}
          data-hww-panel
        >
          <p class="eyebrow" aria-hidden="true">
            <span>{principleNumber(index)}</span> / {principleNumber(PRINCIPLES.length - 1)}
          </p>
          <h3>{title}</h3>
          <p class="subtitle">{subtitle}</p>
          <p class="detail">
            <DetailText runs={detail} />
          </p>
        </div>
      ))
    }
  </div>
</div>

<script>
  import { initTabs } from '../../scripts/how-we-work/tabs';
  initTabs();
</script>

<style>
  /* Stacked (phones, no JS): no tab list, every panel shows with its own title. */
  .list {
    display: none;
  }

  .panels {
    display: grid;
    gap: 72px;
  }

  .eyebrow {
    display: none;
  }

  h3 {
    margin: 0 0 8px;
    font-weight: 500;
    font-size: 20px;
    line-height: var(--leading);
    letter-spacing: -0.02em;
  }

  p {
    margin: 0;
    text-wrap: pretty;
  }

  .subtitle {
    font-size: 22px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--fg);
  }

  .detail {
    max-width: 56ch;
    margin-top: 14px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--subdued);
  }

  /* Tabbed: set by tabs.ts on desktops (with JS). */
  .switch:global(.is-tabbed) {
    display: grid;
    grid-template-columns: calc(var(--grid) * 5) minmax(0, 1fr);
    gap: calc(var(--grid) * 1.5);
    align-items: center;
    min-height: calc(var(--grid) * 6);
  }

  .is-tabbed .list {
    display: grid;
    border-left: 1px solid var(--line);
  }

  .tab {
    position: relative;
    display: grid;
    grid-template-columns: 4ch 1fr;
    align-items: baseline;
    padding: 20px 0 20px 24px;
    border: 0;
    background: none;
    color: var(--faint);
    text-align: start;
    cursor: pointer;
    transition: color 0.3s;
  }

  .tab:hover {
    color: var(--soft);
  }

  .tab[aria-selected='true'] {
    color: var(--fg);
  }

  .tab:focus-visible {
    outline-offset: -2px;
  }

  .tab-num {
    font: 400 11px/var(--leading) var(--mono);
    letter-spacing: 0.08em;
  }

  .tab[aria-selected='true'] .tab-num {
    color: var(--sig);
  }

  .tab-name {
    font-weight: 500;
    font-size: 22px;
    line-height: var(--leading);
    letter-spacing: -0.02em;
  }

  /* The current tab's marker on the list's left rule: fills lime over --advance-ms, then
     tabs.ts moves on; paused until in view, while hovered, and while a tab holds keyboard focus. */
  .bar {
    position: absolute;
    top: 0;
    left: -1px;
    width: 1px;
    height: 100%;
    background: var(--sig);
    box-shadow: 0 0 8px var(--sig-glow);
    transform-origin: top;
    transform: scaleY(0);
  }

  .tab[aria-selected='true'] .bar {
    animation: hww-advance var(--advance-ms) linear forwards paused;
  }

  .switch:global(.is-running):not(:hover, :has(:focus-visible)) .tab[aria-selected='true'] .bar {
    animation-play-state: running;
  }

  @keyframes hww-advance {
    to {
      transform: scaleY(1);
    }
  }

  .is-tabbed .panels {
    display: grid;
  }

  .is-tabbed .panel {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.35s,
      transform 0.35s,
      visibility 0s 0.35s;
  }

  .is-tabbed .panel.is-active {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
      opacity 0.5s 0.1s,
      transform 0.5s 0.1s;
  }

  .is-tabbed .eyebrow {
    display: block;
    margin-bottom: 20px;
    font: 400 11px/var(--leading) var(--mono);
    letter-spacing: 0.12em;
    color: var(--dim);
  }

  .is-tabbed .eyebrow span {
    color: var(--sig);
  }

  /* The tab names the principle; readers still get it from the tab. */
  .is-tabbed h3 {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .is-tabbed .subtitle {
    max-width: 18ch;
    font-weight: 500;
    font-size: 48px;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .is-tabbed .detail {
    margin-top: 24px;
    font-size: 15px;
  }

  @media (max-width: 640px) {
    .subtitle {
      font-size: 20px;
    }
  }
</style>
