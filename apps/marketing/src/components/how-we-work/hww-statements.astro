---
// TEMPORARY (NWARE-82) direction 5, "Statements": each one-liner set as a hero-sized statement
// across the full column, one per screen-ish, with the title as a mono label above and the detail
// small and offset to the right beneath. Scrolling lights each statement in reading order, dim to
// bright, as it rises through the viewport (scripts/how-we-work/statements.ts: --lit 0 → 1;
// without JS it shows lit). Phones: the same, at 34px, the detail full width.
import DetailText from './detail-text.astro';
import { PRINCIPLES, principleNumber } from './principles';
---

<ol class="statements" data-hww-statements>
  {
    PRINCIPLES.map(({ title, subtitle, detail }, index) => (
      <li data-hww-statement>
        <h3>
          <span class="num">{principleNumber(index)}</span>
          <span class="rule" aria-hidden="true" />
          {title}
        </h3>
        <p class="statement">
          <span>{subtitle}</span>
        </p>
        <p class="detail">
          <DetailText runs={detail} />
        </p>
      </li>
    ))
  }
</ol>

<script>
  import { initStatements } from '../../scripts/how-we-work/statements';
  initStatements();
</script>

<style>
  .statements {
    display: grid;
    gap: calc(var(--grid) * 2.5);
    margin: 0;
    padding: var(--grid) 0;
    list-style: none;
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 24px;
    font: 400 11px/var(--leading) var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .num {
    color: var(--sig);
  }

  .rule {
    width: 48px;
    height: 1px;
    background: color-mix(in srgb, var(--sig) 45%, transparent);
  }

  p {
    margin: 0;
    text-wrap: pretty;
  }

  .statement {
    max-width: 17ch;
    font-weight: 500;
    font-size: 72px;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  /* One gradient across the whole inline run (box-decoration-break: slice, the default), so the
     bright edge sweeps the lines in reading order as --lit goes 0 → 1. */
  .statement span {
    color: transparent;
    background: linear-gradient(
      90deg,
      var(--fg) calc(var(--lit, 1) * 100% - 2%),
      color-mix(in srgb, var(--fg) 18%, transparent) calc(var(--lit, 1) * 100% + 2%)
    );
    -webkit-background-clip: text;
    background-clip: text;
  }

  .detail {
    max-width: 52ch;
    margin: 32px 0 0 auto;
    font-size: 15px;
    line-height: 1.6;
    color: var(--subdued);
  }

  @media (max-width: 640px) {
    .statements {
      gap: calc(var(--grid) * 1.5);
      padding: 0;
    }

    .statement {
      font-size: 34px;
      line-height: 1.08;
    }

    .detail {
      margin: 20px 0 0;
      font-size: 14px;
    }
  }
</style>
