---
import type { StatKey, StatsSnapshot } from '@nomadware/site-stats';

import { DEFAULT_STAT_WINDOW } from '../data/stats-snapshot';
import { formatStat } from '../format/format-stat';

// One number in the stats strip. The final value is in the HTML (crawlers, no-JS, no layout
// shift); every window's value rides along in data-values for the 7d/30d toggle and count-up.
interface Props {
  stat: StatKey;
  snapshot: StatsSnapshot;
}
const { stat, snapshot } = Astro.props;
const values = Object.fromEntries(
  Object.entries(snapshot.windows).map(([window, row]) => [window, row[stat]]),
);
---

<span class="stat" data-stat={stat} data-values={JSON.stringify(values)}>
  {formatStat(stat, snapshot.windows[DEFAULT_STAT_WINDOW][stat])}
</span>

<style>
  .stat {
    display: inline-block;
  }
</style>
