---
import '../styles/contact-field.css';
import { CONTACT } from '../constants';

// One prompt line of the contact terminal. The real <input>/<textarea> sits invisibly on top of
// a painted copy (.term-vis) so the caret and fresh-character glow can be custom; it keeps focus,
// selection, autofill and assistive tech. Without JS the real control is shown instead. The copy
// is what the visitor typed, so it is `data-private` (masked in replay, ignored by autocapture).
interface Props {
  name: 'name' | 'email' | 'brief';
  placeholder: string;
  /** A shorter placeholder for phones, where the long one would wrap (CSS picks one). */
  placeholderShort?: string;
  autocomplete?: 'name' | 'email' | 'off';
  /** Keyboard hint. Always type="text": email inputs have no selection API, and the caret needs it. */
  inputmode?: 'text' | 'email';
  multiline?: boolean;
  /** Same limit the endpoint enforces (CONTACT in constants.ts). */
  maxlength: number;
}
const {
  name,
  placeholder,
  placeholderShort,
  autocomplete = 'off',
  inputmode = 'text',
  multiline = false,
  maxlength,
} = Astro.props;
const id = `contact-${name}`;
---

<div class="term-line" data-field={name}>
  <span class="term-prompt" aria-hidden="true">›</span>
  <label class="term-key" for={id}>{name}</label>
  <div class="term-field">
    <div class="term-vis" aria-hidden="true" data-private>
      <span class="term-ph"
        ><span class="term-ph-long">{placeholder}</span>{
          placeholderShort && <span class="term-ph-short">{placeholderShort}</span>
        }</span
      >
    </div>
    {
      multiline ? (
        <textarea
          id={id}
          name={name}
          rows="3"
          required
          minlength={CONTACT.minBriefLength}
          maxlength={maxlength}
          data-placeholder={placeholder}
          data-placeholder-short={placeholderShort}
        />
      ) : (
        <input
          id={id}
          name={name}
          type="text"
          inputmode={inputmode}
          autocomplete={autocomplete}
          maxlength={maxlength}
          spellcheck={inputmode === 'email' ? 'false' : undefined}
          autocapitalize={inputmode === 'email' ? 'off' : undefined}
          required
          data-placeholder={placeholder}
          data-placeholder-short={placeholderShort}
        />
      )
    }
  </div>
</div>
