---
// The stats card's activity chart: agent-minutes per bucket as a seismograph line, one plot per
// window (the current one shown), drawn left to right on reveal. The callout names the peak; on
// hover or touch it follows the pointer instead (scripts/stats-chart.ts reads data-series).
import type { StatsSeries } from '@nomadware/site-stats';
import { STAT_WINDOWS } from '@nomadware/site-stats';

import { linePath, peakOf, pointAt } from '../chart/trace-geometry';
import { DEFAULT_STAT_WINDOW, STATS_CHART } from '../constants';
import { formatAgentTime } from '../format/format-activity';

interface Props {
  series: StatsSeries;
  generatedAt: string;
}
const { series, generatedAt } = Astro.props;
const { viewWidth, viewHeight, peakEdgePercent } = STATS_CHART;
const plots = STAT_WINDOWS.map((range) => {
  const { agentMinutes, bucketHours } = series[range];
  const peak = peakOf(agentMinutes);
  const point = pointAt(agentMinutes, peak.index);
  return {
    range,
    path: linePath(agentMinutes, viewWidth, viewHeight),
    // In % of the plot, so it follows the SVG's stretch; kept off the edges so the label never
    // hangs outside the card.
    peakX: Math.min(100 - peakEdgePercent, Math.max(peakEdgePercent, point.x * 100)),
    peakY: point.y * 100,
    peakText: `peak · ${formatAgentTime(peak.value)} of agent work in ${bucketHours}h`,
  };
});
---

<div
  class="chart"
  aria-hidden="true"
  data-stats-chart
  data-series={JSON.stringify(series)}
  data-generated-at={generatedAt}
>
  {
    plots.map((plot) => (
      <div
        class="plot"
        data-range-label={plot.range}
        data-current={plot.range === DEFAULT_STAT_WINDOW ? '' : undefined}
      >
        <svg viewBox={`0 0 ${viewWidth} ${viewHeight}`} preserveAspectRatio="none">
          <path class="trace" d={plot.path} pathLength="1" />
        </svg>
        <span class="guide" />
        <span class="mark" />
        <span class="callout" style={`--peak-x: ${plot.peakX}%; --peak-y: ${plot.peakY}%`}>
          <span class="peak">{plot.peakText}</span>
          <span class="detail">
            <span data-tip="when" />
            <span data-tip="work" />
            <span>
              day: <span class="added" data-tip="added" /> <span class="deleted" data-tip="deleted" />{' '}
              lines
            </span>
          </span>
        </span>
        <span class="now">now</span>
      </div>
    ))
  }
</div>

<style>
  /* Paper ruled like a seismograph: the page grid's own cell, finer. Vertical swipes still scroll
     the page on touch; horizontal drags scrub the tooltip. */
  .chart {
    position: relative;
    height: 180px;
    border-bottom: 1px solid var(--line);
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 32px 32px;
    touch-action: pan-y;
  }

  .plot {
    position: absolute;
    inset: 24px 24px 16px;
  }

  .plot:not([data-current]) {
    display: none;
  }

  svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Drawn left → right whenever it is shown (display: none → block restarts the animation). */
  .trace {
    fill: none;
    stroke: var(--sig);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: trace-draw 1.6s cubic-bezier(0.3, 0, 0.2, 1) 0.2s forwards;
    filter: drop-shadow(0 0 4px var(--sig-glow));
  }

  @keyframes trace-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .callout,
  .now {
    position: absolute;
    font: 400 11px/var(--leading) var(--mono);
    white-space: nowrap;
  }

  /* At rest: the peak, centred above it. Hovering (data-hover, set by scripts/stats-chart.ts):
     the snapped point's details beside it, at the px corner the script measured. */
  .callout {
    left: var(--peak-x);
    top: var(--peak-y);
    transform: translate(-50%, -150%);
    padding: 2px 6px;
    border: 1px solid var(--sig-soft);
    border-radius: 4px;
    background: var(--ink);
    color: var(--fg);
    pointer-events: none;
  }

  [data-hover] .callout {
    left: var(--tip-left);
    top: var(--tip-top);
    transform: none;
    padding: 4px 8px;
  }

  .detail {
    display: flex;
    flex-direction: column;
  }

  [data-hover] .peak,
  .plot:not([data-hover]) :is(.detail, .guide, .mark) {
    display: none;
  }

  [data-tip='when'],
  .deleted {
    color: var(--dim);
  }

  .added {
    color: var(--sig);
  }

  .guide {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--hover-x);
    width: 1px;
    background: var(--sig-soft);
    pointer-events: none;
  }

  .mark {
    position: absolute;
    left: var(--hover-x);
    top: var(--hover-y);
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--sig);
    box-shadow: 0 0 6px var(--sig-glow);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .now {
    right: -4px;
    bottom: -14px;
    color: var(--faint);
  }

  @media (max-width: 640px) {
    .chart {
      height: 150px;
    }

    .plot {
      inset: 30px 14px 16px;
    }
  }
</style>
