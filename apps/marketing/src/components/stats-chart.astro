---
// The stats card's activity chart: agent-minutes per bucket as a seismograph line, one plot per
// window (the current one shown), a warm marker on it at each bucket that caught issues, drawn
// left to right on a range's first showing (scripts/trace-draw.ts). Hover or touch snaps a dot and
// a guide to a bucket and shows its numbers in a chip (scripts/stats-chart.ts reads data-series).
import type { StatsSeries } from '@nomadware/site-stats';
import { STAT_WINDOWS } from '@nomadware/site-stats';

import { catchMarkers } from '../chart/catch-markers';
import { tracePaths } from '../chart/trace-geometry';
import { DEFAULT_STAT_WINDOW, STATS_CHART } from '../constants';

interface Props {
  series: StatsSeries;
  generatedAt: string;
}
const { series, generatedAt } = Astro.props;
const { viewWidth, viewHeight, markerLabelGapShare } = STATS_CHART;
const plots = STAT_WINDOWS.map((range) => {
  const { agentMinutes, caught } = series[range];
  const { active, quiet } = tracePaths(agentMinutes, viewWidth, viewHeight);
  const markers = catchMarkers(agentMinutes, caught, markerLabelGapShare);
  return { range, active, quiet, markers, points: agentMinutes.length };
});
---

<div
  class="chart"
  aria-hidden="true"
  data-stats-chart
  data-series={JSON.stringify(series)}
  data-generated-at={generatedAt}
>
  {
    plots.map((plot) => (
      <div
        class="plot"
        data-range-label={plot.range}
        data-current={plot.range === DEFAULT_STAT_WINDOW ? '' : undefined}
        data-points={plot.points}
      >
        <svg viewBox={`0 0 ${viewWidth} ${viewHeight}`} preserveAspectRatio="none">
          <path class="quiet" d={plot.quiet} />
          <path class="trace" d={plot.active} />
        </svg>
        {plot.markers.map((marker) => (
          <span
            class:list={['catch', { many: marker.count > 1, crowded: marker.crowded }]}
            data-catch={marker.index}
            style={`--x: ${marker.x}; --y: ${marker.y}`}
          >
            {marker.count > 1 && <span class="count">{marker.count}</span>}
          </span>
        ))}
        <span class="guide" />
        <span class="mark" />
        <span class="tip">
          <span data-tip="when" />
          <span data-tip="work" />
          <span data-tip-lines>
            <span class="added" data-tip="added" /> <span class="deleted" data-tip="deleted" /> lines
          </span>
          <span class="caught" data-tip="caught" hidden />
        </span>
        <span class="now">now</span>
      </div>
    ))
  }
</div>

<style>
  /* Paper ruled like a seismograph: the page grid's own cell, finer. Vertical swipes still scroll
     the page on touch; horizontal drags scrub the tooltip. */
  .chart {
    position: relative;
    height: 240px;
    border-bottom: 1px solid var(--line);
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 32px 32px;
    touch-action: pan-y;
  }

  /* The top inset is the tooltip's own band: the chip sits there (at STATS_CHART.tipTopPx from
     the top), clear of the trace, whose peaks touch the plot's top. Taller than the chip. */
  .plot {
    position: absolute;
    inset: 84px 24px 16px;
  }

  .plot:not([data-current]) {
    display: none;
  }

  svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Drawn left → right as one pen stroke, active and idle stretches alike: a wipe over the whole
     plot (a dash animation would draw every separate stretch at once), run by
     scripts/trace-draw.ts on a range's first showing; hidden until then, shown as is once drawn
     (data-drawn). Without JS, everything shows. */
  :global(html.js) .plot:not([data-drawn]) svg {
    clip-path: inset(0 100% 0 0);
  }

  /* A caught issue: a warm dot on the trace, a little larger with its count above when the bucket
     caught several. HTML over the plot, not SVG: the SVG stretches (preserveAspectRatio none). It
     pops in as the pen reaches it (data-reached), with the issues counter's step. */
  .catch {
    position: absolute;
    left: calc(var(--x) * 100%);
    top: calc(var(--y) * 100%);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--warm);
    box-shadow: 0 0 5px var(--warm-glow);
    transform: translate(-50%, -50%);
    transition:
      opacity 0.2s ease-out,
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: none;
  }

  .catch.many {
    width: 7px;
    height: 7px;
  }

  .count {
    position: absolute;
    bottom: calc(100% + 2px);
    left: 50%;
    transform: translateX(-50%);
    font: 500 9px/1 var(--mono);
    color: var(--warm);
  }

  :global(html.js) .plot:not([data-drawn]) .catch:not([data-reached]) {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.2);
  }

  .trace {
    fill: none;
    stroke: var(--sig);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 4px var(--sig-glow));
  }

  /* Idle stretches: a faint dotted baseline. */
  .quiet {
    fill: none;
    stroke: var(--sig);
    stroke-width: 1;
    stroke-dasharray: 2 5;
    vector-effect: non-scaling-stroke;
    opacity: 0.55;
  }

  .tip,
  .now {
    position: absolute;
    font: 400 11px/var(--leading) var(--mono);
    white-space: nowrap;
  }

  /* Only while pointing (data-hover, set by scripts/stats-chart.ts), at the px corner it measured:
     centred over the snapped point in the band above the trace, overhanging the card if need be
     (the card doesn't clip; above everything around it). */
  .tip {
    display: flex;
    flex-direction: column;
    gap: 5px;
    left: var(--tip-left);
    top: var(--tip-top);
    padding: 4px 8px;
    border: 1px solid var(--sig-soft);
    border-radius: 4px;
    background: var(--ink);
    color: var(--fg);
    pointer-events: none;
    z-index: 1;
  }

  .plot:not([data-hover]) :is(.tip, .guide, .mark) {
    display: none;
  }

  [data-tip='when'],
  .deleted {
    color: var(--dim);
  }

  .added {
    color: var(--sig);
  }

  .caught {
    color: var(--warm);
  }

  .guide {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--hover-x);
    width: 1px;
    background: var(--sig-soft);
    pointer-events: none;
  }

  .mark {
    position: absolute;
    left: var(--hover-x);
    top: var(--hover-y);
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--sig);
    box-shadow: 0 0 6px var(--sig-glow);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .now {
    right: -4px;
    bottom: -14px;
    color: var(--faint);
  }

  @media (max-width: 640px) {
    .chart {
      height: 204px;
    }

    .crowded .count {
      display: none;
    }

    .plot {
      inset: 84px 14px 16px;
    }
  }
</style>
