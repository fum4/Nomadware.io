---
import LogoMark from './logo-mark.astro';
import Wordmark from './wordmark.astro';
---

<header>
  <nav aria-label="Primary">
    <a class="brand" href="/" aria-label="Nomadware home">
      <LogoMark />
      <Wordmark />
    </a>
    <a class="link" href="#contact" data-contact-nav>get in touch</a>
  </nav>
</header>

<script>
  import { track } from '../scripts/analytics/track';
  document
    .querySelector('[data-contact-nav]')
    ?.addEventListener('click', () => track('contact_nav_clicked'));
</script>

<style>
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font: 400 12px/var(--leading) var(--mono);
    color: var(--dim);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--fg);
    font: 600 15px/var(--leading) var(--sans);
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .link {
    padding: 6px 0;
    color: var(--dim);
    text-decoration: none;
    transition: color 0.15s;
  }

  .link:hover {
    color: var(--fg);
  }
</style>
